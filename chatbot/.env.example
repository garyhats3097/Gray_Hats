# Copy this file to chatbot/.env and fill in ONE free key. Never commit .env (it is git-ignored).

# Default: Google Gemini (free tier). Key: https://aistudio.google.com/apikey
CHAT_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: main model, and the free models tried when it is busy (HTTP 503) or missing
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-flash-latest

# Alternative: Groq (free tier). Key: https://console.groq.com/keys
# CHAT_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional
# CHAT_PORT=8787
